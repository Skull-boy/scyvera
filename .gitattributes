# LF everywhere, on every platform. The committed blobs are already LF, so this
# only pins the checkout: a Windows working tree must produce the same bytes as
# the Linux CI runner. Without it, `core.autocrlf=true` rewrites the Rust
# sources to CRLF and `cargo package` would ship a .crate that differs from the
# one CI built and attested (see runtimes/rs/PUBLISHING.md section 4).
* text=auto eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
# RFC 0005 section 6.2: suite-version is exactly `suite-version: <n>\n`.
vectors/suite-version text eol=lf
